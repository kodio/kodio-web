---
import FpSection from '@/components/frontpage/FpSection.astro';
import { cases } from '@/data/frontpage';

export type Props = Record<string, never>;
---

<FpSection
  id="kundecase"
  color="white"
  eyebrow={cases.eyebrow}
  heading={cases.heading}
  intro={cases.intro}
>
  <ul class="case-list">
    {
      cases.items.map((item) => (
        <li class="case-card">
          <p class="case-eyebrow">{item.eyebrow}</p>
          <h3>
            <a href={item.href}>
              {item.heading}
              <span class="case-link-overlay" />
            </a>
          </h3>
          <p class="case-description">{item.description}</p>
          <ul class="case-tags">
            {item.outcomes.map((outcome) => (
              <li>{outcome}</li>
            ))}
          </ul>
          <span class="case-more" aria-hidden="true">
            Les casen
            <svg viewBox="0 0 16 16" width="15" height="15">
              <path
                d="M2 8h11M9 4l4 4-4 4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </li>
      ))
    }
  </ul>
</FpSection>

<style lang="scss">
  .case-list {
    list-style: none;
    display: grid;
    gap: 1.5rem;
    padding: 0;

    @media (min-width: $width-m) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (min-width: $width-l) {
      gap: 1.75rem;
    }
  }

  .case-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--yellow-50);
    border: 0.125rem solid var(--black);
    border-radius: 0.75rem;
    box-shadow: 0.3125rem 0.3125rem 0 var(--black);
    padding: 1.75rem 1.5rem;
    transition:
      translate 0.15s ease,
      box-shadow 0.15s ease;

    @media (min-width: $width-m) {
      padding: 2.25rem 2rem;
    }

    &:hover {
      translate: -0.125rem -0.125rem;
      box-shadow: 0.4375rem 0.4375rem 0 var(--black);
    }

    &:has(a:focus-visible) {
      outline: 0.125rem solid var(--color-focus);
      outline-offset: 0.25rem;
    }
  }

  .case-eyebrow {
    font-family: var(--ff-varela);
    font-size: 0.75rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--orange-500);
    margin-bottom: 0.875rem;
  }

  h3 {
    font-size: 1.375rem;
    line-height: 1.3;
    margin-bottom: 0.875rem;

    @media (min-width: $width-m) {
      font-size: 1.5rem;
    }

    a {
      font-family: inherit;
      color: inherit;
      display: inline;

      &:focus-visible {
        outline: none;
      }
    }
  }

  /* Gjør hele kortet klikkbart uten å nøste interaktive elementer. */
  .case-link-overlay {
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
  }

  .case-description {
    font-size: 1rem;
    line-height: 1.65;
    opacity: 0.82;
    flex-grow: 1;
  }

  .case-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 1.375rem 0 0;
    margin: 0;

    li {
      font-family: var(--ff-varela);
      font-size: 0.8125rem;
      line-height: 1.4;
      padding: 0.3125rem 0.625rem;
      border-radius: 999px;
      background-color: var(--purple-100);
      border: 0.0625rem solid rgba(17, 47, 58, 0.16);
    }
  }

  .case-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    margin-top: 1.375rem;
    font-family: var(--ff-lora);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--green-700);
  }

  .case-card:hover .case-more svg {
    translate: 0.1875rem 0;
  }

  .case-more svg {
    transition: translate 0.15s ease;
  }
</style>
