---
import FpCta from '@/components/frontpage/FpCta.astro';
import { hero } from '@/data/frontpage';

export type Props = Record<string, never>;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        <span class="hero-eyebrow-dot" aria-hidden="true"></span>
        {hero.eyebrow}
      </p>
      <h1>{hero.heading}</h1>
      <p class="hero-lead">{hero.lead}</p>
      <div class="hero-actions">
        <FpCta href={hero.primaryCta.href} external={hero.primaryCta.external} color="yellow-200">
          {hero.primaryCta.label}
        </FpCta>
        <FpCta href={hero.secondaryCta.href} variant="secondary">
          {hero.secondaryCta.label}
        </FpCta>
      </div>
    </div>

    <div class="hero-panel" aria-hidden="true">
      <div class="hero-terminal">
        <div class="hero-terminal-bar">
          <span></span><span></span><span></span>
          <p>kodio · leveranse</p>
        </div>
        <ul class="hero-terminal-body">
          <li><span class="tick">✓</span> dataplattform <em>i produksjon</em></li>
          <li><span class="tick">✓</span> pipelines <em>overvåket &amp; testet</em></li>
          <li><span class="tick">✓</span> ai-modell <em>evaluert &amp; deployet</em></li>
          <li><span class="tick">✓</span> kunnskap <em>overført til teamet</em></li>
          <li class="cursor-line">
            <span class="prompt">›</span> neste oppdrag<span class="caret"></span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="hero-stats-wrap">
    <ul class="hero-stats">
      {
        hero.stats.map((stat) => (
          <li>
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  .hero {
    background-color: var(--white);
    background-image: radial-gradient(circle at 88% -10%, var(--purple-100) 0%, transparent 42%),
      radial-gradient(circle at 4% 108%, var(--yellow-100) 0%, transparent 38%);
    color: var(--color-text);
    max-width: 100vw;
    /* Luft under nøkkeltallene så hjørnekrøllen til neste seksjon ikke overlapper. */
    padding-bottom: 2.5rem;
  }

  .hero-inner,
  .hero-stats-wrap {
    margin: auto;
    max-width: var(--content-max-width);
    padding-inline: var(--content-padding);

    @media (min-width: $width-l) {
      padding-inline: 5rem;
    }
  }

  .hero-inner {
    display: grid;
    gap: 3rem;
    padding-block: 3.5rem 3rem;
    align-items: center;

    @media (min-width: $width-m) {
      padding-block: 5rem 4rem;
    }

    @media (min-width: $width-l) {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 4.5rem;
      padding-block: 6rem 4.5rem;
    }
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--ff-varela);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--orange-500);
    margin-bottom: 1.25rem;
  }

  .hero-eyebrow-dot {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: currentcolor;
    flex-shrink: 0;
  }

  h1 {
    font-size: clamp(2.125rem, 5.6vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin-bottom: 1.5rem;
    max-width: 18ch;
  }

  .hero-lead {
    font-size: 1.0625rem;
    line-height: 1.75;
    max-width: 44ch;
    opacity: 0.88;

    @media (min-width: $width-m) {
      font-size: 1.25rem;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  /* Illustrasjonspanel */
  .hero-panel {
    display: none;

    @media (min-width: $width-l) {
      display: block;
    }
  }

  .hero-terminal {
    background-color: var(--green-900);
    color: var(--white);
    border: 0.125rem solid var(--black);
    border-radius: 0.75rem;
    box-shadow: 0.5rem 0.5rem 0 var(--black);
    overflow: hidden;
    rotate: -1.2deg;
  }

  .hero-terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.75rem 1rem;
    background-color: var(--green-800);
    border-bottom: 0.0625rem solid rgba(255, 253, 245, 0.14);

    span {
      width: 0.6875rem;
      height: 0.6875rem;
      border-radius: 50%;
      background-color: var(--orange-400);

      &:nth-child(2) {
        background-color: var(--yellow-200);
      }

      &:nth-child(3) {
        background-color: var(--purple-300);
      }
    }

    p {
      margin-left: 0.5rem;
      font-size: 0.8125rem;
      letter-spacing: 0.06em;
      opacity: 0.6;
      line-height: 1;
    }
  }

  .hero-terminal-body {
    list-style: none;
    margin: 0;
    padding: 1.5rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    font-family: var(--ff-varela);
    font-size: 1rem;
    line-height: 1.5;

    li {
      display: flex;
      align-items: baseline;
      gap: 0.625rem;
    }

    em {
      font-style: normal;
      opacity: 0.62;
    }

    .tick {
      color: var(--yellow-200);
      font-weight: 700;
    }

    .prompt {
      color: var(--orange-300);
      font-weight: 700;
    }

    .cursor-line {
      margin-top: 0.375rem;
      padding-top: 0.875rem;
      border-top: 0.0625rem solid rgba(255, 253, 245, 0.14);
      opacity: 0.72;
    }

    .caret {
      display: inline-block;
      width: 0.5rem;
      height: 1rem;
      margin-left: 0.375rem;
      translate: 0 0.125rem;
      background-color: var(--orange-300);
      animation: blink 1.1s step-end infinite;
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0;
    }
  }

  /* Nøkkeltall — 1px gap på en grå flate gir hårfine skillelinjer */
  .hero-stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.0625rem;
    background-color: rgba(17, 47, 58, 0.16);
    border-block: 0.0625rem solid rgba(17, 47, 58, 0.16);
    padding: 0;
    margin: 0;

    @media (min-width: $width-m) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    li {
      background-color: var(--white);
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      padding: 1.5rem 1.25rem;

      @media (min-width: $width-l) {
        padding: 1.75rem 2rem;
      }
    }

    .stat-value {
      font-family: var(--ff-lora);
      font-size: clamp(1.75rem, 3.2vw, 2.5rem);
      font-weight: 700;
      line-height: 1.1;
      color: var(--green-800);
    }

    .stat-label {
      font-family: var(--ff-varela);
      font-size: 0.9375rem;
      line-height: 1.4;
      opacity: 0.7;
    }
  }
</style>
