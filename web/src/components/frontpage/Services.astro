---
import FpSection from '@/components/frontpage/FpSection.astro';
import { services } from '@/data/frontpage';

export type Props = Record<string, never>;
---

<FpSection
  id="tjenester"
  color="green-800"
  eyebrow={services.eyebrow}
  heading={services.heading}
  intro={services.intro}
>
  <ul class="service-list">
    {
      services.items.map((service) => (
        <li class="service-card" id={service.id}>
          <div class="service-head">
            <span class="service-number" aria-hidden="true">
              {service.eyebrow}
            </span>
            <div>
              <h3>{service.heading}</h3>
              <p class="service-description">{service.description}</p>
            </div>
          </div>

          <ul class="service-deliverables">
            {service.deliverables.map((deliverable) => (
              <li>
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path
                    d="M3 8.5l3.5 3.5L13 4.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>{deliverable}</span>
              </li>
            ))}
          </ul>

          <div class="service-stack">
            <p class="service-stack-label">Verktøykassa</p>
            <ul>
              {service.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</FpSection>

<style lang="scss">
  .service-list {
    list-style: none;
    display: grid;
    gap: 1.5rem;
    padding: 0;

    @media (min-width: $width-l) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.75rem;
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    background-color: var(--white);
    color: var(--color-text);
    border: 0.125rem solid var(--black);
    border-radius: 0.75rem;
    box-shadow: 0.3125rem 0.3125rem 0 var(--black);
    padding: 1.75rem 1.5rem 1.5rem;
    scroll-margin-top: 6rem;

    @media (min-width: $width-m) {
      padding: 2.25rem 2rem 2rem;
    }
  }

  .service-head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .service-number {
    font-family: var(--ff-lora);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    color: var(--orange-500);
    background-color: var(--yellow-100);
    border: 0.09375rem solid var(--black);
    border-radius: 0.25rem;
    padding: 0.4375rem 0.5rem;
    flex-shrink: 0;
  }

  h3 {
    font-size: 1.375rem;
    line-height: 1.3;
    margin-bottom: 0.75rem;

    @media (min-width: $width-m) {
      font-size: 1.5rem;
    }
  }

  .service-description {
    font-size: 1rem;
    line-height: 1.65;
    opacity: 0.82;
  }

  .service-deliverables {
    list-style: none;
    padding: 1.5rem 0 0;
    margin: 1.5rem 0 0;
    border-top: 0.0625rem solid rgba(17, 47, 58, 0.14);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;

    li {
      display: flex;
      align-items: flex-start;
      gap: 0.625rem;
      font-family: var(--ff-varela);
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    svg {
      flex-shrink: 0;
      margin-top: 0.25rem;
      color: var(--orange-500);
    }
  }

  .service-stack {
    margin-top: 1.75rem;
  }

  .service-stack-label {
    font-family: var(--ff-varela);
    font-size: 0.75rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    opacity: 0.55;
    margin-bottom: 0.75rem;
  }

  .service-stack ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0;

    li {
      font-family: var(--ff-varela);
      font-size: 0.8125rem;
      line-height: 1.4;
      padding: 0.3125rem 0.625rem;
      border-radius: 999px;
      background-color: var(--purple-100);
      border: 0.0625rem solid rgba(17, 47, 58, 0.16);
      white-space: nowrap;
    }
  }
</style>
