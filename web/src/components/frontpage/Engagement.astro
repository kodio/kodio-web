---
import FpSection from '@/components/frontpage/FpSection.astro';
import { engagement } from '@/data/frontpage';

export type Props = Record<string, never>;
---

<FpSection
  id="samarbeid"
  color="yellow-50"
  eyebrow={engagement.eyebrow}
  heading={engagement.heading}
  intro={engagement.intro}
>
  <ol class="engagement-list">
    {
      engagement.items.map((item, index) => (
        <li>
          <span class="engagement-step" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3>{item.heading}</h3>
          <p class="engagement-description">{item.description}</p>
          <ul class="engagement-details">
            {item.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</FpSection>

<style lang="scss">
  .engagement-list {
    list-style: none;
    display: grid;
    gap: 0;
    padding: 0;
    border: 0.125rem solid var(--black);
    border-radius: 0.75rem;
    background-color: var(--white);
    box-shadow: 0.3125rem 0.3125rem 0 var(--black);
    overflow: hidden;

    @media (min-width: $width-l) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    > li {
      padding: 2rem 1.75rem;
      border-bottom: 0.125rem solid rgba(17, 47, 58, 0.14);

      &:last-child {
        border-bottom: 0;
      }

      @media (min-width: $width-l) {
        padding: 2.5rem 2.25rem;
        border-bottom: 0;
        border-right: 0.125rem solid rgba(17, 47, 58, 0.14);

        &:last-child {
          border-right: 0;
        }
      }
    }
  }

  .engagement-step {
    display: inline-block;
    font-family: var(--ff-lora);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--orange-500);
    margin-bottom: 0.875rem;
  }

  h3 {
    font-size: 1.3125rem;
    line-height: 1.3;
    margin-bottom: 0.75rem;

    @media (min-width: $width-m) {
      font-size: 1.4375rem;
    }
  }

  .engagement-description {
    font-size: 1rem;
    line-height: 1.65;
    opacity: 0.82;
  }

  .engagement-details {
    list-style: none;
    padding: 1.25rem 0 0;
    margin: 1.25rem 0 0;
    border-top: 0.0625rem solid rgba(17, 47, 58, 0.14);
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;

    li {
      font-family: var(--ff-varela);
      font-size: 0.8125rem;
      line-height: 1.4;
      padding: 0.3125rem 0.625rem;
      border-radius: 999px;
      background-color: var(--yellow-100);
      border: 0.0625rem solid rgba(17, 47, 58, 0.16);
    }
  }
</style>
